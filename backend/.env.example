# Quete Backend — Переменные окружения
# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env

# ---- База данных (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://quete_user:quete_password@localhost:5432/quete_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
# Сгенерируй случайный секрет: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Google Gemini API ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Приложение ----
APP_ENV=development
LOG_LEVEL=DEBUG
