{
  "$schema": "https://repomix.com/schemas/json/config.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": [
    "backend/**/*.py",
    "client/lib/**/*.dart",
    "docs/architecture/**/*.md",
    "AGENTS.md"
  ],
  "ignore": {
    "customPatterns": [
      "**/__pycache__/**",
      "**/venv/**",
      "**/.venv/**",
      "**/build/**",
      "**/.dart_tool/**",
      "scratch/**",
      ".artifacts/**"
    ]
  }
}
