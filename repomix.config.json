{
  "$schema": "https://repomix.com/schemas/json/config.json",
  "output": {
    "filePath": ".repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": ["backend/**/*.py", "client/lib/**/*.dart"],
  "ignore": {
    "customPatterns": [
      "**/__pycache__/**",
      "**/venv/**",
      "**/build/**",
      "**/.dart_tool/**",
      "scratch/**",
      ".artifacts/**"
    ]
  }
}
