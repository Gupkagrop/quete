# Quete — Корневые переменные окружения
# Скопируйте этот файл в .env перед локальным запуском:
#   cp .env.example .env

# ==========================================
# 1. PostgreSQL (Docker Compose & Backend)
# ==========================================
POSTGRES_USER=quete_user
POSTGRES_PASSWORD=quete_password
POSTGRES_DB=quete_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quete_user:quete_password@localhost:5432/quete_db

# ==========================================
# 2. Redis (Docker Compose & Backend)
# ==========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 3. JWT & Security
# ==========================================
# Сгенерируйте случайный ключ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# 4. Google Gemini API
# ==========================================
# Ключ от Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# 5. Приложение (FastAPI)
# ==========================================
APP_ENV=development
LOG_LEVEL=DEBUG
