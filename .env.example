# Настройки подключения к базе данных
DB_HOST=127.0.0.1
DB_NAME=quete_db
DB_USER=root
DB_PASS=

# API ключи искусственного интеллекта
# Получить ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Настройки прокси для работы с ИИ из РФ через VPN (например, VLESS/SOCKS5)
USE_PROXY=false
PROXY_ADDRESS=127.0.0.1:10808
PROXY_TYPE=socks5h

# Режим локального запуска (отключает CSP, HSTS и HSTS-заголовки, включает автоопределение WebSocket-хоста)
LOCAL_LAUNCH=true

# Хост WebSocket клиента для продакшена (на сервере укажите quete.ru)
# WS_CLIENT_HOST=quete.ru
# Внешний порт WebSocket клиента для продакшена (через SSL Nginx прокси - 8888)
# WS_CLIENT_PORT=8888

# Внутренние настройки WebSocket сервера (для обхода конфликтов портов с Nginx)
# WS_PORT=8888
# WS_HOST=0.0.0.0

