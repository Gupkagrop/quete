# ==============================================================================
# 🚪 Файл .gitignore для проекта Quete (Куэте)
# Соответствует всем современным стандартам веб-разработки (PHP, Composer, Web)
# ==============================================================================

# ⚙️ Системные файлы и кэш ОС
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
~*
.fuse_hidden*
.directory
.Trash-*
.*.swp
.nfs*

# 🔑 Секреты и конфигурация окружения (Environment)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env.local

# Разрешаем отслеживание демонстрационного шаблона окружения
!.env.example

# 📦 Зависимости и пакетные менеджеры
# ------------------------------------------------------------------------------
# Composer (PHP)
vendor/
composer.phar

# Node.js (если появится сборка фронтенда)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.yarn/
.eslintcache

# 🛠️ Настройки сред разработки и редакторов (IDEs / Editors)
# ------------------------------------------------------------------------------
# PhpStorm / WebStorm / JetBrains
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Sublime Text / TextMate
*.sublime-project
*.sublime-workspace
.sconsign.dblite
.tags*

# NetBeans / Eclipse
nbproject/private/
build/
nbbuild/
dist/
.metadata/

# 📊 Логи, кэш и временные файлы
# ------------------------------------------------------------------------------
*.log
logs/
cache/
tmp/
temp/
*.tmp
*.temp
.phpunit.result.cache
.crash

# 💾 Базы данных и дампы (исключая эталонную структуру)
# ------------------------------------------------------------------------------
*.sqlite
*.db
# Разрешаем отслеживание эталонного дампа БД проекта
!database.sql

# Резервные копии и временные дампы (чтобы случайно не закоммитить бэкап)
*.sql.gz
*.sql.zip
*.sql.bak
*backup*.sql
*dump*.sql

# 🌐 Специфичные папки серверов (Open Server / OS Panel)
# ------------------------------------------------------------------------------
.osp/